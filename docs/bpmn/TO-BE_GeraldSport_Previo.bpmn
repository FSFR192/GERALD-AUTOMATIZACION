<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_GS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.0.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Pool_gs" name="Gerald Sport · Contratación de pedidos y coordinación de materiales (TO-BE)" processRef="Proc_gs" />
  </bpmn:collaboration>
  <bpmn:error id="Err_sys" name="Error de sistema" errorCode="SISTEMA" />
  <bpmn:error id="Err_trans" name="Error transitorio" errorCode="TRANSITORIO" />
  <bpmn:dataStore id="Store_cat" name="Catálogo de materiales" />
  <bpmn:dataStore id="Store_inv" name="Inventario de materiales" />
  <bpmn:process id="Proc_gs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_cli" name="Cliente">
        <bpmn:flowNodeRef>S_ini</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>I_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_noc</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_sis" name="Sistema multiagente (automatizado)">
        <bpmn:flowNodeRef>T_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_dup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_bos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_eval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_obs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_coh</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_auto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_con</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_lis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_bos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_mat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cola</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_pend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_alert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_det</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cola2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_pend2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_alert2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_det2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_adm" name="Administrador">
        <bpmn:flowNodeRef>T_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_esc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_ap</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_alm" name="Almacén de materiales (proveedores)">
        <bpmn:flowNodeRef>T_abs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_ini" name="Cliente requiere confeccionar pedido">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_S_ini" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_enviar" name="Enviar pedido con boceto, tallas, colores y cantidad">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_corr" name="Corregir pedido según observaciones">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_acep" name="Aceptar cotización y contrato (1 clic)">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_48" name="48 h sin respuesta" cancelActivity="false" attachedToRef="T_acep">
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_48"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="I_rec" name="Recordatorio automático">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_I_rec" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="E_rec" name="">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_acep" name="¿Acepta la cotización?">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_noc" name="Pedido no contratado">
      <bpmn:incoming>F30</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_rec" name="Recibir y validar el pedido">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_comp" name="¿Datos completos y válidos?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_dup" name="Verificar si el pedido ya fue registrado">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_dup" name="¿Pedido duplicado?">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_inf" name="Informar que el pedido ya existe">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_dup" name="Duplicado descartado">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_reg" name="Registrar pedido y confirmar recepción al cliente">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_bos" name="Interpretar el boceto (agente de diseño)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_mat" name="Calcular materiales y costo con el catálogo del almacén">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:property id="P_0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_0"><bpmn:sourceRef>DS1</bpmn:sourceRef><bpmn:targetRef>P_0</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T_eval" name="Evaluar coherencia y nivel de confianza">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sendTask id="T_obs" name="Enviar observaciones precisas al cliente">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G_coh" name="¿Pedido coherente?">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_auto" name="¿Confianza alta y costo dentro del umbral?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_mer" name="">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_cot" name="Generar y enviar cotización y contrato">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_con" name="Registrar contrato del pedido">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_disp" name="Verificar disponibilidad de materiales en el almacén">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:property id="P_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_1"><bpmn:sourceRef>DS2</bpmn:sourceRef><bpmn:targetRef>P_1</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_stock" name="¿Stock suficiente?">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_req" name="Generar requerimiento de abastecimiento">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="T_res" name="Reservar materiales para el pedido">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_lis" name="Generar lista de materiales y orden de producción">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_not" name="Notificar al cliente y al administrador la fecha estimada">
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_fin" name="Pedido contratado y materiales coordinados">
      <bpmn:incoming>F40</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_rev" name="Revisar y aprobar propuesta (solo casos de excepción)">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_24" name="24 h sin revisión" cancelActivity="false" attachedToRef="T_rev">
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_24"><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="T_esc" name="Recordar y escalar la revisión">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_esc" name="Revisión escalada">
      <bpmn:incoming>F24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_ap" name="¿Aprobado?">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:boundaryEvent id="B_reg" name="Error de sistema (registro)" attachedToRef="T_reg">
      <bpmn:outgoing>FE1</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_reg" errorRef="Err_sys" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_bos" name="Reintentos agotados (3)" attachedToRef="T_bos">
      <bpmn:outgoing>FE2</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_bos" errorRef="Err_trans" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_mat" name="Catálogo no disponible" attachedToRef="T_mat">
      <bpmn:outgoing>FE3</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_mat" errorRef="Err_trans" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_cola" name="Guardar pedido completo en cola de pendientes">
      <bpmn:incoming>FE2</bpmn:incoming>
      <bpmn:incoming>FE3</bpmn:incoming>
      <bpmn:outgoing>FE4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_pend" name="Pendiente de reproceso automático">
      <bpmn:incoming>FE4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T_alert" name="Alertar al responsable">
      <bpmn:incoming>FE1</bpmn:incoming>
      <bpmn:outgoing>FE5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_det" name="Flujo detenido">
      <bpmn:incoming>FE5</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_E_det" errorRef="Err_sys" />
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_disp" name="Inventario no disponible" attachedToRef="T_disp">
      <bpmn:outgoing>FE6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_disp" errorRef="Err_trans" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="T_cola2" name="Guardar pedido en cola de pendientes">
      <bpmn:incoming>FE6</bpmn:incoming>
      <bpmn:outgoing>FE7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_pend2" name="Pendiente de reproceso">
      <bpmn:incoming>FE7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B_res" name="Error de sistema (reserva)" attachedToRef="T_res">
      <bpmn:outgoing>FE8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_res" errorRef="Err_sys" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="T_alert2" name="Alertar al responsable">
      <bpmn:incoming>FE8</bpmn:incoming>
      <bpmn:outgoing>FE9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_det2" name="Flujo detenido">
      <bpmn:incoming>FE9</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_E_det2" errorRef="Err_sys" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS1" name="Catálogo de materiales (telas, insumos, precios)" dataStoreRef="Store_cat" />
    <bpmn:dataStoreReference id="DS2" name="Inventario de materiales (stock)" dataStoreRef="Store_inv" />
    <bpmn:userTask id="T_abs" name="Abastecer material faltante">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_2"><bpmn:targetRef>DS2</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F1" sourceRef="S_ini" targetRef="T_enviar" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_enviar" targetRef="T_rec" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_rec" targetRef="G_comp" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="G_comp" targetRef="T_obs" />
    <bpmn:sequenceFlow id="F5" name="Sí" sourceRef="G_comp" targetRef="T_dup" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_dup" targetRef="G_dup" />
    <bpmn:sequenceFlow id="F7" name="Sí" sourceRef="G_dup" targetRef="T_inf" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_inf" targetRef="E_dup" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="G_dup" targetRef="T_reg" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_reg" targetRef="T_bos" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_bos" targetRef="T_mat" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_mat" targetRef="T_eval" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_eval" targetRef="G_coh" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G_coh" targetRef="T_obs" />
    <bpmn:sequenceFlow id="F15" name="Sí" sourceRef="G_coh" targetRef="G_auto" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_obs" targetRef="T_corr" />
    <bpmn:sequenceFlow id="F17" name="Reenvío" sourceRef="T_corr" targetRef="T_enviar" />
    <bpmn:sequenceFlow id="F18" name="Sí (aprobación automática)" sourceRef="G_auto" targetRef="G_mer" />
    <bpmn:sequenceFlow id="F19" name="No" sourceRef="G_auto" targetRef="T_rev" />
    <bpmn:sequenceFlow id="F20" sourceRef="T_rev" targetRef="G_ap" />
    <bpmn:sequenceFlow id="F21" name="Sí" sourceRef="G_ap" targetRef="G_mer" />
    <bpmn:sequenceFlow id="F22" name="No" sourceRef="G_ap" targetRef="T_obs" />
    <bpmn:sequenceFlow id="F23" sourceRef="B_24" targetRef="T_esc" />
    <bpmn:sequenceFlow id="F24" sourceRef="T_esc" targetRef="E_esc" />
    <bpmn:sequenceFlow id="F25" sourceRef="G_mer" targetRef="T_cot" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_cot" targetRef="T_acep" />
    <bpmn:sequenceFlow id="F27" sourceRef="B_48" targetRef="I_rec" />
    <bpmn:sequenceFlow id="F28" sourceRef="I_rec" targetRef="E_rec" />
    <bpmn:sequenceFlow id="F29" sourceRef="T_acep" targetRef="G_acep" />
    <bpmn:sequenceFlow id="F30" name="No" sourceRef="G_acep" targetRef="E_noc" />
    <bpmn:sequenceFlow id="F31" name="Sí" sourceRef="G_acep" targetRef="T_con" />
    <bpmn:sequenceFlow id="F32" sourceRef="T_con" targetRef="T_disp" />
    <bpmn:sequenceFlow id="F33" sourceRef="T_disp" targetRef="G_stock" />
    <bpmn:sequenceFlow id="F34" name="Sí" sourceRef="G_stock" targetRef="T_res" />
    <bpmn:sequenceFlow id="F35" name="No" sourceRef="G_stock" targetRef="T_req" />
    <bpmn:sequenceFlow id="F36" sourceRef="T_req" targetRef="T_abs" />
    <bpmn:sequenceFlow id="F37" sourceRef="T_abs" targetRef="T_res" />
    <bpmn:sequenceFlow id="FE1" sourceRef="B_reg" targetRef="T_alert" />
    <bpmn:sequenceFlow id="FE2" sourceRef="B_bos" targetRef="T_cola" />
    <bpmn:sequenceFlow id="FE3" sourceRef="B_mat" targetRef="T_cola" />
    <bpmn:sequenceFlow id="FE4" sourceRef="T_cola" targetRef="E_pend" />
    <bpmn:sequenceFlow id="FE5" sourceRef="T_alert" targetRef="E_det" />
    <bpmn:sequenceFlow id="FE6" sourceRef="B_disp" targetRef="T_cola2" />
    <bpmn:sequenceFlow id="FE7" sourceRef="T_cola2" targetRef="E_pend2" />
    <bpmn:sequenceFlow id="FE8" sourceRef="B_res" targetRef="T_alert2" />
    <bpmn:sequenceFlow id="FE9" sourceRef="T_alert2" targetRef="E_det2" />
    <bpmn:sequenceFlow id="F38" sourceRef="T_res" targetRef="T_lis" />
    <bpmn:sequenceFlow id="F39" sourceRef="T_lis" targetRef="T_not" />
    <bpmn:sequenceFlow id="F40" sourceRef="T_not" targetRef="E_fin" />
    <bpmn:textAnnotation id="A1"><bpmn:text>Intervención mínima: el cliente solo envía el pedido y acepta la cotización; el administrador solo revisa casos dudosos o de costo alto.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3"><bpmn:text>Manejo de errores por clase: datos incompletos → observaciones al cliente · duplicados → se descartan · transitorios → 3 reintentos automáticos y cola de pendientes (pedido completo) · de sistema → se detiene el flujo y se alerta al responsable.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2"><bpmn:text>El almacén (proveedores) es la fuente de información de telas, insumos, precios y stock que usa el sistema.</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
