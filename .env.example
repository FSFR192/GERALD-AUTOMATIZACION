# Copiar a .env y completar. Nunca versionar .env.
GERALD_MODO=produccion
GERALD_DATABASE_URL=postgresql://gerald:gerald@localhost:5432/gerald
GERALD_JWT_SECRETO=genera-uno-con-python-c-import-secrets-print-secrets-token-urlsafe-48

# Modelo: google (Gemini con visión) u ollama (local)
GERALD_LLM_PROVEEDOR=google
GERALD_GOOGLE_API_KEY=
GERALD_MODELO_GOOGLE=gemini-2.5-flash
GERALD_MODELO_OLLAMA=llava

# Correo (mailpit en desarrollo: docker compose --profile correo up -d)
GERALD_SMTP_HOST=localhost
GERALD_CORREO_ADMIN=admin@geraldsport.pe
GERALD_CORREO_ALMACEN=almacen@geraldsport.pe

# Observabilidad (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gerald-sport
LANGSMITH_HIDE_INPUTS=true
